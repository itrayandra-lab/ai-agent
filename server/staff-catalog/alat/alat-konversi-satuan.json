  "inputs": [
    {
      "key": "nilai",
      "type": "number",
      "label": "Angka yang diubah",
      "required": true,
      "contoh": "10"
    },
    {
      "key": "jenis",
      "type": "choice",
      "label": "Ubah dari ke",
      "required": true,
      "default": "km_mil",
      "choices": [
        {
          "v": "km_mil",
          "t": "Kilometer ke mil"
        },
        {
          "v": "mil_km",
          "t": "Mil ke kilometer"
        },
        {
          "v": "kg_lb",
          "t": "Kilogram ke pound"
        },
        {
          "v": "lb_kg",
          "t": "Pound ke kilogram"
        },
        {
          "v": "m_ft",
          "t": "Meter ke kaki"
        },
        {
          "v": "cm_in",
          "t": "Sentimeter ke inci"
        },
        {
          "v": "c_f",
          "t": "Celsius ke Fahrenheit"
        },
        {
          "v": "f_c",
          "t": "Fahrenheit ke Celsius"
        }
      ]
    }
  ],
  "steps": [
    {
      "id": "h",
      "use": "hitung",
      "label": "Ubah",
      "set": {
        "hasil": "(({ km_mil: (x) => x * 0.621371, mil_km: (x) => x * 1.609344, kg_lb: (x) => x * 2.204623, lb_kg: (x) => x * 0.453592, m_ft: (x) => x * 3.280840, ft_m: (x) => x * 0.3048, cm_in: (x) => x * 0.393701, l_gal: (x) => x * 0.264172, c_f: (x) => x * 9 / 5 + 32, f_c: (x) => (x - 32) * 5 / 9 })[input.jenis])(input.nilai)",
        "satuan": "({ km_mil: 'mil', mil_km: 'km', kg_lb: 'pound', lb_kg: 'kg', m_ft: 'kaki', ft_m: 'meter', cm_in: 'inci', l_gal: 'galon', c_f: '°F', f_c: '°C' })[input.jenis]"
      }
    }
  ],
  "output": {
    "ringkas": "input.nilai + ' menjadi ' + (Math.round(v.hasil * 10000) / 10000) + ' ' + v.satuan",
    "teks": "'**' + input.nilai + '** = **' + (Math.round(v.hasil * 10000) / 10000) + ' ' + v.satuan + '**'"
  },
  "sample": {
    "input": {
      "nilai": "10",
      "jenis": "km_mil"
    },
    "expect": {
      "berkas": 0,
      "mengandung": [
        "6.2137 mil"
      ]
    }
  },
