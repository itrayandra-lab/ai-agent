        }
      ]
    }
  ],
  "steps": [
    {
      "id": "s1",
      "use": "hitung",
      "label": "Hitung skor",
      "set": {
        "kriteria": "[['Kebutuhan pasar', Number(input.pasar), 30], ['Kemudahan membuat', Number(input.teknis), 25], ['Keuntungan', Number(input.margin), 20], ['Keamanan aturan', Number(input.regulasi), 15], ['Kecocokan brand', Number(input.brand), 10]]",
        "skor": "Math.round(v.kriteria.reduce((s, k) => s + k[1] * k[2], 0) / 5)",
        "lemah": "v.kriteria.filter((k) => k[1] <= 2).map((k) => k[0])",
        "putusan": "v.skor >= 75 ? 'Lanjutkan ke tahap berikutnya' : v.skor >= 60 ? 'Perbaiki konsep dulu' : 'Hentikan atau rancang ulang'"
      }
    }
  ],
  "output": {
    "ringkas": "input.konsep + ': skor ' + v.skor + ' dari 100. ' + v.putusan",
    "teks": "'# Penilaian konsep: ' + input.konsep + '\\n\\n' + tabel(['Sisi', 'Nilai (1-5)', 'Bobot %'], v.kriteria.map((k) => [k[0], k[1], k[2]])) + '\\n\\n**Skor akhir: ' + v.skor + '/100 - ' + v.putusan + '**\\n\\nPatokan: 75 ke atas lanjut, 60 sampai 74 perbaiki, di bawah 60 hentikan.' + (v.lemah.length ? '\\n\\nSisi yang lemah (nilai 2 ke bawah): ' + v.lemah.join(', ') : '')",
    "berkas": [
      {
        "jenis": "csv",
        "nama": "'penilaian-konsep-' + input.konsep",
        "isi": "csv([['Sisi', 'Nilai', 'Bobot']].concat(v.kriteria).concat([['Skor akhir', v.skor, 100]]))"
      }
    ]
  },
  "schedule": {
    "allowed": false
  },
  "risk": "low",
  "confirm": false,
  "brain": {
    "folder": "Product",
    "simpan": true
  },
