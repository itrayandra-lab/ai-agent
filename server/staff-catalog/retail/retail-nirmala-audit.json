        },
        {
          "v": "0",
          "t": "Belum"
        }
      ]
    },
    {
      "key": "harga",
      "type": "choice",
      "label": "Harga terpasang di semua produk",
      "required": true,
      "default": "2",
      "choices": [
        {
          "v": "2",
