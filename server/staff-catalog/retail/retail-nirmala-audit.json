      "maksPanjang": 600
    },
    "contohAI": "{\"pembahasan\":\"Hasil daftar periksa tampilan toko perlu dibaca bersama: audit visual menjadi fokus utama dan angka dari aturan sudah dipakai apa adanya.\",\"ide\":[\"Coba satu langkah kecil dulu\",\"Catat hasilnya minggu depan\"],\"langkah\":[\"Periksa isian yang paling berpengaruh\",\"Putuskan tindakan hari ini\",\"Catat hasilnya\"]}"
  }
