{
  "name": "ray-agent-office",
  "version": "1.0.0",
  "description": "AI Company OS: karyawan AI + manusia lintas divisi, otak perusahaan (knowledge graph), dan kantor 3D real-time.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "reset": "node server/index.js --reset-only",
    "test": "npm run check:visual && node --test test/*.test.js",
    "check:visual": "node scripts/verify-visual-lock.mjs",
    "check:invariants": "node scripts/check-invariants.mjs",
    "data:backup": "node scripts/backup-data.mjs",
    "data:restore": "node scripts/restore-data.mjs",
    "browser:install": "npm install --prefix data/browser-mcp chrome-devtools-mcp@1.13.0 --no-audit --no-fund --ignore-scripts"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "three": "^0.187.0"
  }
}
